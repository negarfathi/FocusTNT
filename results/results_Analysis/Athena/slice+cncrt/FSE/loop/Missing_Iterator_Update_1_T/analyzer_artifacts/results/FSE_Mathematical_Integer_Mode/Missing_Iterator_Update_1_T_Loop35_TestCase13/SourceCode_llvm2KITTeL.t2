///*** 1_main ***///
START: main_bb5;

FROM: main_bb5;
__fc_errno := 0;
v3 := __fc_errno;
TO: main_bb5_end;

FROM: main_bb5_end;
assume(v3 != 1);
TO: main_bb6;

FROM: main_bb5_end;
assume(v3 == 1);
TO: main_bb7;

FROM: main_bb6;
__fc_errno := 1;
TO: main_waitpid_slice_1.exit;

FROM: main_bb7;
__fc_errno := 2;
TO: main_waitpid_slice_1.exit;

FROM: main_waitpid_slice_1.exit;
TO: main_waitpid_slice_1.exit_end;

FROM: main_waitpid_slice_1.exit_end;
assume(1 <= 0);
TO: main_bb8;

FROM: main_waitpid_slice_1.exit_end;
assume(0 <= 0);
TO: main_bb11;

FROM: main_bb8;
v6 := __fc_errno;
TO: main_bb8_end;

FROM: main_bb8_end;
assume(v6 != 1);
TO: main_bb9;

FROM: main_bb8_end;
assume(v6 == 1);
TO: main_bb10;

FROM: main_bb9;
__fc_errno := 1;
TO: main_waitpid_slice_1.exit1;

FROM: main_bb10;
__fc_errno := 2;
TO: main_waitpid_slice_1.exit1;

FROM: main_waitpid_slice_1.exit1;
v9 := __fc_errno;
TO: main_waitpid_slice_1.exit1_end;

FROM: main_waitpid_slice_1.exit1_end;
assume(v9 == 1);
TO: main_bb8;

FROM: main_waitpid_slice_1.exit1_end;
assume(v9 != 1);
TO: main_bb11;

FROM: main_bb11;
TO: main_bb11_ret;

