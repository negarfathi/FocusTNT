///*** 1_main ***///
START: main_bb0;

FROM: main_bb0;
vmain.ereg := nondet();
vslots_used := nondet();
vereg := nondet();
v2 := 0;
v1 := store_array(v1, v2, 2);
v3 := 1;
v1 := store_array(v1, v3, 3);
v4 := v5;
var__temp_vi.0 := 0;
TO: main_bb1;

FROM: main_bb1;
vi.0 := var__temp_vi.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vi.0 slt 10);
TO: main_bb2;

FROM: main_bb1_end;
assume(vi.0 sge 10);
TO: main_bb3;

FROM: main_bb2;
v7 := vi.0 + 1;
var__temp_vi.0 := v7;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

