TO: main_bb8_end;

FROM: main_bb8_end;
assume(vtable.0 != 0);
TO: main_bb10;

FROM: main_bb8_end;
assume(vtable.0 == 0);
TO: main_bb9;

FROM: main_bb9;
v26 := vi_0.0 + 1;
var__temp_vi_0.0 := v26;
TO: main_bb3;

FROM: main_bb10;
TO: main_bb10_ret;

