TO: main_bb1;

FROM: main_bb1;
v4 := 1;
v3 := store_array(v3, v4, 1);
v5 := 3;
v3 := store_array(v3, v5, 1);
v6 := 5;
v3 := store_array(v3, v6, 1);
v7 := 7;
v3 := store_array(v3, v7, 1);
var__temp_vi.0 := 0;
TO: main_bb2;

FROM: main_bb2;
vi.0 := var__temp_vi.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vi.0 slt 9);
TO: main_bb3;

FROM: main_bb2_end;
assume(vi.0 sge 9);
TO: main_bb4;

FROM: main_bb3;
v9 := vi.0 + 1;
