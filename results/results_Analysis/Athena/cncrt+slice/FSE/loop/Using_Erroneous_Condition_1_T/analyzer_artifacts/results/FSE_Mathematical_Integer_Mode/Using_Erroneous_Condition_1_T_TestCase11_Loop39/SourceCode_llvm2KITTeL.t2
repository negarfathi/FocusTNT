v16 := select_tuple(v14, 1, 2);
v18 := v16 + 1;
TO: main_bb1_vpos.0;
FROM: main_bb1_vpos.0;
assume(v16 sge 1);
vpos.0 := v16;
TO: main_bb1_svpos.0;

