TO: main_bb2_sv.;

FROM: main_bb2_sv.;
var__temp_vpos.1 := v.;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(v. != v23);
TO: main_bb2;

FROM: main_bb2_end;
assume(v. == v23);
TO: main_bb3;

FROM: main_bb3;
TO: main_bb3_ret;

