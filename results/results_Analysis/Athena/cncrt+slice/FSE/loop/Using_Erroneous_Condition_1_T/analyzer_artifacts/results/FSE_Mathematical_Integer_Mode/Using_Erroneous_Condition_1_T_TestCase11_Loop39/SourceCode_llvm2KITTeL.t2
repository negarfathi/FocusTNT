v19 := sign_extend(32, 64, v4);
v20 := select_array(vmemory0, v19);
v22 := select_tuple(v20, 0, 2);
v23 := vpos.0 srem v22;
v24 := sign_extend(32, 64, v4);
v25 := select_array(vmemory0, v24);
v27 := select_tuple(v25, 0, 2);
