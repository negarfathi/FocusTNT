///*** 1_main ***///
START: main_bb1;

FROM: main_bb1;
memory0_freeIndex := 1;
vmemory0 := nondet();
v4 := memory0_freeIndex;
v5 := memory0_freeIndex;
v6 := v5 + 8;
memory0_freeIndex := v6;
v7 := sign_extend(32, 64, v4);
v8 := select_array(vmemory0, v7);
v9v0 := select_tuple(v8, 0, 2);
v9v2 := constr_tuple(v9v0, -1);
vmemory0 := store_array(vmemory0, v7, v9v2);
v10 := sign_extend(32, 64, v4);
v11 := select_array(vmemory0, v10);
