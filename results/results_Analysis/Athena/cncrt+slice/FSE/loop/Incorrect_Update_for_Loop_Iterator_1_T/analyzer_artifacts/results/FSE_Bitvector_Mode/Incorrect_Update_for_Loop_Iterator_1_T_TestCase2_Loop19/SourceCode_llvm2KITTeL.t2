///*** 1_main ***///
START: main_bb0;

FROM: main_bb0;
var__temp_vsize.0 := 64;
var__temp_vbuffer_bytes_left.0 := 0;
TO: main_bb0_end;

FROM: main_bb0_end;
assume(1 <= 0);
TO: main_bb3;

FROM: main_bb0_end;
assume(0 <= 0);
TO: main_bb1;

FROM: main_bb1;
vsize.0 := var__temp_vsize.0;
vbuffer_bytes_left.0 := var__temp_vbuffer_bytes_left.0;
v1 := vsize.0 sdiv 2;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vbuffer_bytes_left.0 slt v1);
TO: main_bb2;

FROM: main_bb1_end;
assume(vbuffer_bytes_left.0 sge v1);
TO: main_bb3;

FROM: main_bb2;
v3 := vsize.0 * 2;
v4 := v3 - vbuffer_bytes_left.0;
var__temp_vsize.0 := v3;
var__temp_vbuffer_bytes_left.0 := v4;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

