///*** 1_main ***///
START: main_bb1;
TYPE dummy: bv(32);


FROM: main_bb1;
flag := 0;
var__temp_vb.0 := 7;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(1 <= 0);
TO: main_bb4;

FROM: main_bb1_end;
assume(0 <= 0);
TO: main_bb2;

FROM: main_bb2;
vb.0 := var__temp_vb.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vb.0 slt 10);
TO: main_bb3;

FROM: main_bb2_end;
assume(vb.0 sge 10);
TO: main_bb4;

FROM: main_bb3;
flag := 1;
v3 := vb.0 + 0;
v4 := 10 - 4;
var__temp_vb.0 := v3;
TO: main_bb3_end;

FROM: main_bb3_end;
assume(v3 sge v4);
TO: main_bb4;

FROM: main_bb3_end;
assume(v3 slt v4);
TO: main_bb2;

FROM: main_bb4;
TO: main_bb4_ret;

