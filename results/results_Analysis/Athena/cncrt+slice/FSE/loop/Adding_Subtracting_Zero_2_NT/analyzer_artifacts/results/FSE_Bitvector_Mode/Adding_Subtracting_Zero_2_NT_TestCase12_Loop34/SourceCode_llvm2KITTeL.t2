///*** 1_main ***///
START: main_bb3;

FROM: main_bb3;
flag := 0;
var__temp_vb.0 := 1;
TO: main_bb3_end;

FROM: main_bb3_end;
assume(1 <= 0);
TO: main_bb7;

FROM: main_bb3_end;
assume(0 <= 0);
TO: main_bb4;

FROM: main_bb4;
vb.0 := var__temp_vb.0;
TO: main_bb4_end;

FROM: main_bb4_end;
assume(vb.0 slt 10);
TO: main_bb5;

FROM: main_bb4_end;
assume(vb.0 sge 10);
TO: main_bb7;

FROM: main_bb5;
v5 := flag;
TO: main_bb5_end;

FROM: main_bb5_end;
assume(v5 == 1);
TO: main_ff_subtitles_next_line_slice_1.exit;

FROM: main_bb5_end;
assume(v5 != 1);
TO: main_bb6;

FROM: main_bb6;
flag := 1;
TO: main_ff_subtitles_next_line_slice_1.exit;

FROM: main_ff_subtitles_next_line_slice_1.exit;
v7 := vb.0 + 0;
v8 := 10 - 4;
var__temp_vb.0 := v7;
TO: main_ff_subtitles_next_line_slice_1.exit_end;

FROM: main_ff_subtitles_next_line_slice_1.exit_end;
assume(v7 sge v8);
TO: main_bb7;

FROM: main_ff_subtitles_next_line_slice_1.exit_end;
assume(v7 slt v8);
TO: main_bb4;

FROM: main_bb7;
TO: main_bb7_ret;

