///*** 1_main ***///
START: main_bb0;

FROM: main_bb0;
vmain.old_ := nondet();
vmain.new_ := nondet();
vold_ := nondet();
vnew_ := nondet();
v0 := v1;
v2 := v3;
v4 := 9;
vold_ := store_array(vold_, v4, 0);
v5 := 9;
vnew_ := store_array(vnew_, v5, 0);
var__temp_vi.0 := 0;
TO: main_bb1;

FROM: main_bb1;
vi.0 := var__temp_vi.0;
v6 := sign_extend(32, 64, vi.0);
v7 := v6;
v8 := select_array(vold_, v7);
v9 := sign_extend(32, 64, vi.0);
v10 := v9;
v11 := select_array(vnew_, v10);
TO: main_bb2;

FROM: main_bb2;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(v8 != v11);
TO: main_bb2;

FROM: main_bb2_end;
assume(v8 == v11);
TO: main_bb3;

FROM: main_bb3;
v13 := vi.0 + 1;
var__temp_vi.0 := v13;
TO: main_bb1;

