///*** 1_main ***///
START: main_bb0;
TYPE dummy: bv(32);


FROM: main_bb0;
vold_ := nondet();
vnew_ := nondet();
v3 := 3;
v2 := store_array(v2, v3, 1);
v4 := 9;
vold_ := store_array(vold_, v4, 0);
v5 := 9;
vnew_ := store_array(vnew_, v5, 0);
var__temp_vbase.0 := 3;
