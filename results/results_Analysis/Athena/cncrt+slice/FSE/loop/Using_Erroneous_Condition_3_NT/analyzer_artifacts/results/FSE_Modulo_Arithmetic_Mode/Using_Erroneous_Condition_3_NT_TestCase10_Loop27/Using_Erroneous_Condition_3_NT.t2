///*** 1_main ***///
START: main_bb5;



FROM: main_bb5;
vold_ := nondet();
vnew_ := nondet();
v15 := 0;
v14 := store_array(v14, v15, 3);
v16 := 0;
v17 := select_array(vold_, v16);
v18 := 0;
v19 := select_array(vnew_, v18);
TO: main_bb6;

FROM: main_bb6;
TO: main_bb6_end;

FROM: main_bb6_end;
assume(v17 != v19);
TO: main_bb6;

FROM: main_bb6_end;
assume(v17 == v19);
TO: main_bb7;

FROM: main_bb7;
TO: main_bb7_ret;

