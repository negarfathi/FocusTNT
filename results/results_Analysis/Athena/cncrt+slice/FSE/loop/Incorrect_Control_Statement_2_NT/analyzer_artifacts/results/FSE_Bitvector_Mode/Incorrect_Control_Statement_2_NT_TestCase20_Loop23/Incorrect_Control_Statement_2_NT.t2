///*** 1_main ***///
START: main_bb0;
TYPE dummy: bv(32);


FROM: main_bb0;
vslots_used := nondet();
v2 := 0;
v1 := store_array(v1, v2, 2);
v3 := 1;
v1 := store_array(v1, v3, 3);
var__temp_vi.0 := 0;
TO: main_bb1;

FROM: main_bb1;
vi.0 := var__temp_vi.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vi.0 slt 10);
TO: main_bb2;

FROM: main_bb1_end;
assume(vi.0 sge 10);
TO: main_bb3;

FROM: main_bb2;
v5 := vi.0 + 1;
var__temp_vi.0 := v5;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_end;

FROM: main_bb3_end;
assume(0 <= 0);
TO: main_bb3;

FROM: main_bb3_end;
assume(1 <= 0);
TO: main_bb4;

FROM: main_bb4;
TO: main_bb4_ret;

