///*** 1_main ***///
START: main_bb0;

FROM: main_bb0;
var__temp_vsize.0 := 64;
var__temp_vbuffer_bytes_left.0 := 0;
TO: main_bb0_end;

FROM: main_bb0_end;
assume(1 <= 0);
TO: main_bb3;

FROM: main_bb0_end;
assume(0 <= 0);
TO: main_bb1;

FROM: main_bb1;
vsize.0 := var__temp_vsize.0;
vbuffer_bytes_left.0 := var__temp_vbuffer_bytes_left.0;
v1 := vsize.0 sdiv 2;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vbuffer_bytes_left.0 slt v1);
TO: main_bb2;

FROM: main_bb1_end;
assume(vbuffer_bytes_left.0 sge v1);
TO: main_bb3;

FROM: main_bb2;
v3 := vsize.0 * 2;
TO: main_bb2_v.;
FROM: main_bb2_v.;
assume(v3 sgt 100);
v. := 100;
TO: main_bb2_sv.;

FROM: main_bb2_v.;
assume(v3 sle 100);
v. := v3;
TO: main_bb2_sv.;

FROM: main_bb2_sv.;
v5 := v. - 60;
var__temp_vsize.0 := v.;
var__temp_vbuffer_bytes_left.0 := v5;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

