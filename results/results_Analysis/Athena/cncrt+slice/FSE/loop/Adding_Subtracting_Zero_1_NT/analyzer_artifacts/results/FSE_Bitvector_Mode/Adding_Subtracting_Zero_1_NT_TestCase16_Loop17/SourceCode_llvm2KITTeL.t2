///*** 1_main ***///
START: main_bb0;

FROM: main_bb0;
var__temp_vh.0 := 7;
TO: main_bb1;

FROM: main_bb1;
vh.0 := var__temp_vh.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vh.0 sgt 0);
TO: main_bb2;

FROM: main_bb1_end;
assume(vh.0 sle 0);
TO: main_bb3;

FROM: main_bb2;
v1 := vh.0 - 0;
var__temp_vh.0 := v1;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

