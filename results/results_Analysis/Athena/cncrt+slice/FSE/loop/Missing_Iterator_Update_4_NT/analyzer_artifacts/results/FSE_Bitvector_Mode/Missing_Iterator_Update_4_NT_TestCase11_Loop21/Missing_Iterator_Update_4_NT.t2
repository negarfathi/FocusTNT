///*** 1_main ***///
START: main_bb0;
TYPE dummy: bv(32);


FROM: main_bb0;
var__temp_vy.0 := 0;
TO: main_bb0_end;

FROM: main_bb0_end;
assume(1 <= 0);
TO: main_bb1;

FROM: main_bb0_end;
assume(0 <= 0);
TO: main_bb2;

FROM: main_bb1;
TO: main_bb1_ret;

FROM: main_bb2;
vy.0 := var__temp_vy.0;
v4 := vy.0 + 1;
TO: main_bb2_v.;
FROM: main_bb2_v.;
assume(vy.0 slt 10);
v. := v4;
TO: main_bb2_sv.;

FROM: main_bb2_v.;
assume(vy.0 sge 10);
v. := 0;
TO: main_bb2_sv.;

FROM: main_bb2_sv.;
var__temp_vy.0 := v.;
TO: main_bb2;

