///*** 1_main ***///
START: main_bb1;
TYPE dummy: bv(32);


FROM: main_bb1;
flag := 0;
var__temp_vtries.0 := 0;
var__temp_vbuf.0 := 0;
var__temp_vcount.0 := 4;
TO: main_bb2;

FROM: main_bb2;
vtries.0 := var__temp_vtries.0;
vbuf.0 := var__temp_vbuf.0;
vcount.0 := var__temp_vcount.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vcount.0 sgt 0);
TO: main_bb3;

FROM: main_bb2_end;
assume(vcount.0 sle 0);
TO: main_bb6;

FROM: main_bb3;
TO: main_bb3_v__retres.0.i;
FROM: main_bb3_v__retres.0.i;
assume(vbuf.0 slt vcount.0);
v__retres.0.i := 1;
TO: main_bb3_sv__retres.0.i;

FROM: main_bb3_v__retres.0.i;
assume(vbuf.0 sge vcount.0);
v__retres.0.i := 0;
TO: main_bb3_sv__retres.0.i;

FROM: main_bb3_sv__retres.0.i;
TO: main_bb3_end;

FROM: main_bb3_end;
assume(v__retres.0.i sle 0);
TO: main_bb4;

FROM: main_bb3_end;
assume(v__retres.0.i sgt 0);
TO: main_bb5;

FROM: main_bb4;
v5 := vtries.0 + 1;
var__temp_vtries.0 := v5;
var__temp_vbuf.0 := vbuf.0;
var__temp_vcount.0 := vcount.0;
TO: main_bb4_end;

FROM: main_bb4_end;
assume(vtries.0 slt 5);
TO: main_bb2;

FROM: main_bb4_end;
assume(vtries.0 sge 5);
TO: main_bb6;

FROM: main_bb5;
v7 := vcount.0 - v__retres.0.i;
v8 := vbuf.0 + v__retres.0.i;
var__temp_vtries.0 := vtries.0;
var__temp_vbuf.0 := v8;
var__temp_vcount.0 := v7;
TO: main_bb2;

FROM: main_bb6;
TO: main_bb6_ret;

