///*** 1_main ***///
START: main_bb0;

FROM: main_bb0;
var__temp_vi.0 := 0;
TO: main_bb0_end;

FROM: main_bb0_end;
assume(1 <= 0);
TO: main_bb1;

FROM: main_bb0_end;
assume(0 <= 0);
TO: main_bb2;

FROM: main_bb1;
TO: main_bb1_ret;

FROM: main_bb2;
vi.0 := var__temp_vi.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vi.0 slt 5);
TO: main_bb3;

FROM: main_bb2_end;
assume(vi.0 sge 5);
TO: main_bb4;

FROM: main_bb3;
v3 := vi.0 + 1;
var__temp_vi.0 := v3;
TO: main_bb2;

FROM: main_bb4;
TO: main_bb4_ret;

