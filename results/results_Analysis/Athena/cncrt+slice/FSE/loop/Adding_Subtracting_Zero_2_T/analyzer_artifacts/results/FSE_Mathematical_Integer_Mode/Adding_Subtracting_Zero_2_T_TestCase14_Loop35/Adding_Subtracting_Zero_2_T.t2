///*** 1_main ***///
START: main_bb1;
TYPE dummy: bv(32);


FROM: main_bb1;
var__temp_vb.0 := 1;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(1 <= 0);
TO: main_bb4;

FROM: main_bb1_end;
assume(0 <= 0);
TO: main_bb2;

FROM: main_bb2;
vb.0 := var__temp_vb.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vb.0 slt 5);
TO: main_bb3;

FROM: main_bb2_end;
assume(vb.0 sge 5);
TO: main_bb4;

FROM: main_bb3;
v5 := vb.0 + 17;
v6 := 5 - 4;
var__temp_vb.0 := v5;
TO: main_bb3_end;

FROM: main_bb3_end;
assume(v5 sge v6);
TO: main_bb4;

FROM: main_bb3_end;
assume(v5 slt v6);
TO: main_bb2;

FROM: main_bb4;
TO: main_bb4_ret;

