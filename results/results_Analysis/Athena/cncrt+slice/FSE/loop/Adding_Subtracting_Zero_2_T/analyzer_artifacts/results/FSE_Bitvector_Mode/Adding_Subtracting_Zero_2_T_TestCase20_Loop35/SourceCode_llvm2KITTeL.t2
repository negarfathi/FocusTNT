///*** 1_main ***///
START: main_bb1;

FROM: main_bb1;
var__temp_vb.0 := 0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(1 <= 0);
TO: main_bb4;

FROM: main_bb1_end;
assume(0 <= 0);
TO: main_bb2;

FROM: main_bb2;
vb.0 := var__temp_vb.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vb.0 slt 2);
TO: main_bb3;

FROM: main_bb2_end;
assume(vb.0 sge 2);
TO: main_bb4;

FROM: main_bb3;
v4 := vb.0 + 1;
v5 := 2 - 4;
var__temp_vb.0 := v4;
TO: main_bb3_end;

FROM: main_bb3_end;
assume(v4 sge v5);
TO: main_bb4;

FROM: main_bb3_end;
assume(v4 slt v5);
TO: main_bb2;

FROM: main_bb4;
TO: main_bb4_ret;

